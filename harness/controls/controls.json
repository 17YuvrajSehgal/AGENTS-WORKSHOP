  "logging":      {"lang": "py", "cpus": "2",   "oracle_row": "less logging / output",     "expect": {"sc:write": "down"}},
  "alloc":        {"lang": "py", "cpus": "2",   "oracle_row": "fewer allocations",         "expect": {"minor-faults": "down", "sc:mmap": "down"}},
  "algorithmic":  {"lang": "py", "cpus": "2",   "oracle_row": "algorithmic",               "expect": {"instructions": "down", "task-clock": "down"}},
  "locality":     {"lang": "c",  "cpus": "2",   "oracle_row": "data locality",             "expect": {"L1-dcache-load-misses": "down", "l2_rqsts.miss": "down"}},
