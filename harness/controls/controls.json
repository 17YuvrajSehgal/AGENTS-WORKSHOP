  "parallel":     {"lang": "py", "cpus": "2,3", "oracle_row": "add parallelism",           "expect": {"wall_s": "down", "task-clock": "not_down"}},
  "async_io":     {"lang": "py", "cpus": "2,3", "oracle_row": "async / non-blocking I/O",  "expect": {"wall_s": "down", "offcpu_ns_main": "down"}},
  "lazy_import":  {"lang": "py", "cpus": "2",   "oracle_row": "lazy loading / startup",    "expect": {"sc:openat": "down", "bytes_read": "down"}},
  "stat_loop":    {"lang": "py", "cpus": "2",   "oracle_row": "fewer syscalls in a hot loop", "expect": {"sc:stat_any": "down"}}
